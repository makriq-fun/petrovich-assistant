#!/bin/sh
# Hysteria 2: локальный SOCKS5 для STT/LLM. Запускается до petrovichd.
D=/data/petrovich/opt/hysteria2
BIN=/tmp/hysteria2
PID=/run/hysteria2.pid
if [ ! -x "$BIN" ] && [ -f "$D/hysteria.gz" ]; then
  gzip -dc "$D/hysteria.gz" >"$BIN" && chmod +x "$BIN"
fi
case "${1:-start}" in
  start)
    if [ -f "$PID" ] && kill -0 "$(cat "$PID" 2>/dev/null)" 2>/dev/null; then
      exit 0
    fi
    "$BIN" -c /data/petrovich/hysteria.yaml >>"$D/hysteria.log" 2>&1 &
    echo $! >"$PID"
    ;;
  stop)
    [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null
    rm -f "$PID"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *) exit 2 ;;
esac
