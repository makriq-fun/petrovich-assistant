#!/bin/sh
# Запускает petrovichd после загрузки. Если /data/petrovich/enabled отсутствует,
# ничего не делает: штатный Quasar тогда может работать как раньше.
D=/data/petrovich
[ -f "$D/enabled" ] || exit 0
[ -x "$D/supervise.sh" ] || exit 0
[ -x "$D/current/petrovichd" ] || exit 0
mkdir -p "$D/log" "$D/state" /run
# Никогда не поднимаем Алису как запасной вариант.
/system/vendor/quasar/q stop >/dev/null 2>&1 || true
# Сеть и DNS после загрузки поднимаются позже rootfs: без ожидания
# Spotify/YouTube стартуют с «Temporary failure in name resolution».
i=0
while [ "$i" -lt 60 ]; do
    ip route 2>/dev/null | grep -q '^default ' &&
        nslookup accounts.spotify.com >/dev/null 2>&1 &&
        [ "$(date +%Y)" -ge 2025 ] && break
    sleep 2
    i=$((i + 1))
done
setsid "$D/supervise.sh" </dev/null >/dev/null 2>&1 &
